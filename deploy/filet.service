[Unit]
Description=filet 控制面（账号、设备列表、信令）+ 内置 STUN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 先创建专用用户：useradd --system --home /var/lib/filet --shell /usr/sbin/nologin filet
User=filet
Group=filet
# 把 --public-ip 换成 ECS 公网 IP（会自动下发内置 STUN 地址）
ExecStart=/usr/local/bin/filet server -l 127.0.0.1:8085 -d /var/lib/filet --stun :3478 --public-ip 203.0.113.10
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/filet
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
